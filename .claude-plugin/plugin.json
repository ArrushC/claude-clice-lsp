{
  "name": "clice-lsp",
  "description": "C/C++ language server (clice) for code intelligence",
  "version": "1.0.0",
  "author": {
    "name": "Arrush",
    "url": "https://github.com/ArrushC"
  },
  "homepage": "https://github.com/ArrushC/claude-clice-lsp#readme",
  "repository": "https://github.com/ArrushC/claude-clice-lsp",
  "license": "MIT",
  "keywords": [
    "lsp",
    "language-server",
    "clice",
    "c",
    "cpp",
    "c++",
    "cpp-modules",
    "code-intelligence"
  ],
  "lspServers": {
    "clice": {
      "command": "clice",
      "args": [
        "serve"
      ],
      "extensionToLanguage": {
        ".c": "c",
        ".h": "c",
        ".cpp": "cpp",
        ".CPP": "cpp",
        ".cc": "cpp",
        ".CC": "cpp",
        ".cxx": "cpp",
        ".CXX": "cpp",
        ".c++": "cpp",
        ".C++": "cpp",
        ".cp": "cpp",
        ".C": "cpp",
        ".hpp": "cpp",
        ".hxx": "cpp",
        ".hh": "cpp",
        ".H": "cpp",
        ".cppm": "cpp",
        ".ccm": "cpp",
        ".cxxm": "cpp",
        ".c++m": "cpp",
        ".ixx": "cpp",
        ".mxx": "cpp",
        ".mpp": "cpp",
        ".inl": "cpp",
        ".ipp": "cpp",
        ".tpp": "cpp",
        ".tcc": "cpp",
        ".txx": "cpp",
        ".inc": "cpp",
        ".def": "cpp",
        ".m": "objective-c",
        ".mm": "objective-cpp",
        ".M": "objective-cpp",
        ".cu": "cuda-cpp",
        ".cuh": "cuda-cpp",
        ".hip": "hip",
        ".cl": "opencl",
        ".clcpp": "opencl"
      }
    }
  }
}
